  "/api/v1/sessions/{session_id}/samples": {
   "get": {
    "tags": [
     "sessions"
    ],
    "summary": "Samples",
    "description": "Samples in physical units where the conversion is known. Long ranges are reduced to a\nmin/max envelope (2 points per bucket) so peaks are never hidden by decimation. Gaps are\nreturned as null values between runs.",
    "operationId": "samples_api_v1_sessions__session_id__samples_get",
    "security": [
     {
      "HTTPBearer": []
     }
    ],
    "parameters": [
     {
      "name": "session_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Session Id"
      }
     },
     {
      "name": "stream",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^(ecg|ppg|imu)$",
       "title": "Stream"
      }
     },
     {
      "name": "t_from",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ],
       "title": "T From"
      }
     },
     {
      "name": "t_to",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ],
       "title": "T To"
      }
     },
     {
      "name": "max_points",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "maximum": 20000,
       "minimum": 100,
       "default": 2000,
       "title": "Max Points"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "additionalProperties": true,
         "title": "Response Samples Api V1 Sessions  Session Id  Samples Get"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
