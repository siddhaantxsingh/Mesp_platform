# Copy to .env and fill in. NEVER commit .env.
POSTGRES_PASSWORD=change-me-long-random
MESP_JWT_SECRET=change-me-generate-with-openssl-rand-base64-48
MESP_ADMIN_EMAIL=admin@example.com
MESP_ADMIN_PASSWORD=change-me-at-least-10-chars
MESP_DEMO_MODE=true
MESP_DEMO_AUTOSTART_SCENARIO=normal
# For the optional gateway container (docker compose --profile gateway up):
MESP_DEVICE_KEY=
MESP_GATEWAY_SOURCE=sim
MESP_GATEWAY_SCENARIO=normal
